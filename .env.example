# 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意: .env 文件已被 .gitignore 忽略，不会提交到 Git

# 飞书多维表格配置（已迁移到 feishu-base-config.json）
# 请编辑 feishu-base-config.json 文件填入以下信息:
# - base_name: 多维表格名称
# - base_token: 多维表格 token
# - base_url: 多维表格 URL
# - tables: 各数据表的 table_id

# CDP 浏览器调试端口（用于抖音、小红书评论抓取）
DOUYIN_CDP_BRIDGE_PORT=3457
XIAOHONGSHU_CDP_BRIDGE_PORT=3458

# Chrome 远程调试端口（默认 9222）
CHROME_CDP_PORT=9222

# Whisper ASR 设备（cuda 或 cpu）
WHISPER_DEVICE=cuda

# Whisper 模型（tiny, base, small, medium, large-v3-turbo）
WHISPER_MODEL=large-v3-turbo